# Talk-to-Pinterest-SB-remote — environment variables
# Copy to .env for local runs (never commit .env). On Railway, set these as
# service variables.

# --- Pinterest app + auth (required) ---------------------------------------
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
# Long-lived seed refresh token from scripts/mint_seed_token.py.
# Pinterest does NOT rotate this by default, so a static value is fine.
PINTEREST_REFRESH_TOKEN=
# Multiple Pinterest logins (e.g. agency + client-owned accounts): JSON map of
# profile name -> that login's refresh token. Same app id/secret for all. When set
# it replaces PINTEREST_REFRESH_TOKEN. Order = priority: if two logins see the same
# ad account the first wins, and it is the default for boards/pins calls.
# PINTEREST_PROFILES={"superbolt":"pinr.xxx","sgs":"pinr.yyy"}
PINTEREST_PROFILES=
# Optional — the server mints fresh access tokens via refresh; not required.
PINTEREST_ACCESS_TOKEN=

# --- Optional -------------------------------------------------------------
# Default ad account id so account_id can be omitted on ads/analytics tools.
PINTEREST_AD_ACCOUNT_ID=
# Only if your app has refresh-token ROTATION enabled: a durable file path
# (mount a Railway volume) where the rotated refresh token is persisted. With
# PINTEREST_PROFILES each profile gets its own file: <path>.<profile>.
# Leave unset otherwise.
PINTEREST_TOKEN_PATH=
# Override the API base (rarely needed).
PINTEREST_API_BASE=https://api.pinterest.com/v5

# --- Safety ---------------------------------------------------------------
# Max daily budget (account currency, e.g. dollars) a draft_create_* may set.
PINLOOP_MAX_DAILY_BUDGET=50.0
# When "true" (default), confirm_and_apply is forced to dry-run — flip to
# "false" to allow real writes.
PINLOOP_REQUIRE_DRY_RUN=false

# --- Transport / connector auth -------------------------------------------
# Public URL of the deployed service (used for DNS-rebinding allowed hosts).
SERVER_URL=
# Shared secret embedded in the connector URL (?access_token=...). Leave empty
# for fully open (not recommended for a write-capable server).
MCP_AUTH_TOKEN=
